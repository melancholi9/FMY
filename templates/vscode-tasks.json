{
  // このファイルをリポジトリの .vscode/tasks.json にコピーすると、
  // VS Code でフォルダを開いた瞬間にターミナルパネルで Claude Code が起動します。
  // 初回は「タスクの自動実行を許可しますか?」と聞かれるので「許可」を選択してください。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Claude Code 自動起動",
      "type": "shell",
      "command": "claude",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
